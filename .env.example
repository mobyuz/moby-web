# Upstream origin for the local Vite proxy.
MOBY_API_ORIGIN=http://127.0.0.1:8080

# Public Turnstile site key for the website hostname.
VITE_MOBY_TURNSTILE_SITE_KEY=

# Policy versions accepted by the running API for registration and Google sign-in.
VITE_MOBY_TERMS_VERSION=dev-1
VITE_MOBY_PRIVACY_POLICY_VERSION=dev-1
